# Required in production: a long random string used to sign session tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. With it, answers are generated by Claude; without it, Veritas runs in extractive mode.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Optional. With it, retrieval uses Voyage semantic embeddings instead of the local hashing embedder.
VOYAGE_API_KEY=

# Seed the "Helix Systems" demo tenant and users on first start.
SEED_DEMO=true
RATE_LIMIT_PER_MIN=30
QUERY_RETENTION_DAYS=90
